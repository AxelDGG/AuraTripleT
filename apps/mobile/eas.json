{
  "cli": { "version": ">= 5.0.0", "appVersionSource": "local" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": { "PUBLIC_API_URL": "http://localhost:3040" }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": { "PUBLIC_API_URL": "https://norte.example.com" }
    },
    "production": {
      "autoIncrement": true,
      "env": { "PUBLIC_API_URL": "https://norte.example.com" }
    }
  },
  "submit": { "production": {} }
}
