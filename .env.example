# ===== Requerida =====
GROQ_API_KEY=tu_api_key_de_groq
GROQ_MODEL=openai/gpt-oss-120b
PORT=3040

# ===== Opcionales: ya implementadas, todas con un default que funciona =====
# LLM_PROVIDER=groq                   # groq (default, el más rápido) | gemini (tier gratis por requests/día: aguanta muchos turnos seguidos)
# BANK_DATA_SOURCE=memory             # memory (default) | tiger
# DEMO_CUSTOMER_ID=CLT-889201         # cliente al que se atribuye el historial sin sesión
# DATABASE_URL=postgres://user:pass@host:5432/tsdb?sslmode=require   # Tiger Cloud
# DATABASE_URL=postgres://norte:norte@localhost:5432/norte           # docker compose local

# Sesión (login de la app móvil).
# Sin AUTH_SECRET la API genera una llave por proceso: funciona en local, pero
# las sesiones mueren al reiniciar. En producción (NODE_ENV=production) es
# obligatoria y debe tener al menos 16 caracteres.
#   Generar una:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# AUTH_SECRET=
# AUTH_TOKEN_TTL_HOURS=12             # duración de la sesión (default 12)
# AUTH_REQUIRED=false                 # true exige token en toda /api, no solo en las rutas con sesión
#
# Usuarios sintéticos de la demo (apps/api/src/auth/users.js), contraseña Banorte2026:
#   regina · carlos · maria

# Voz (STT + TTS con ElevenLabs). Sin ellas la web cae a Web Speech del navegador
# y la app móvil avisa que el dictado no está disponible.
# El voice ID debe ser una voz "premade": las de librería piden plan de pago.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# Agente de ElevenLabs Conversational AI (Maya): créalo en elevenlabs.io/app/conversational-ai
# ELEVENLABS_AGENT_ID=

# ===== App móvil y widget =====
# URL que se compila dentro de la app (apps/mobile/app.config.js → extra.apiUrl).
# Se puede cambiar en caliente desde Servicios → Conexión sin recompilar.
# PUBLIC_API_URL=http://localhost:3040
# PUBLIC_API_URL=https://149-28-10-5.sslip.io   # Vultr con HTTPS vía sslip.io

# ===== Despliegue en Vultr (solo en el .env del servidor) =====
# NORTE_DOMAIN=149-28-10-5.sslip.io   # dominio con el que Caddy pide el certificado
# NODE_ENV=production

# Gemini como orquestador (LLM_PROVIDER=gemini). Key gratis en https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash

# ===== Aún no implementadas: no hace falta conseguir estas keys =====
# SNOWFLAKE_ACCOUNT=
# SNOWFLAKE_USER=
# SNOWFLAKE_PASSWORD=
# SNOWFLAKE_WAREHOUSE=
# SNOWFLAKE_DATABASE=

# ===== Norte A2UI (streaming de la interfaz) =====
# Pausa entre envíos de componentes al cliente, para que la pantalla se vea
# construir. 0 la desactiva (los tests la ponen en 0).
# A2UI_STREAM_DELAY_MS=110

# ===== Google Calendar MCP =====
# Credenciales del OAuth client (tipo "Desktop app") creado en
# https://console.cloud.google.com/auth/clients (proyecto con Google Calendar API habilitada)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3045/oauth2callback
# Tras configurarlas, corre una vez: npm run google:auth
